{
  "name": "mopay-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:contracts": "cd contracts && forge test",
    "db:generate": "pnpm --filter @mopay/db generate",
    "db:migrate": "pnpm --filter @mopay/db migrate",
    "db:seed": "pnpm --filter @mopay/db seed"
  },
  "devDependencies": {
    "@restatedev/restate": "1.8.1",
    "@restatedev/restate-server": "1.8.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
