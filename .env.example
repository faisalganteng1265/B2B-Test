# ---- chain ----
CHAIN=base-sepolia
# comma separated; first is primary, rest are viem fallback transports
RPC_URLS=https://sepolia.base.org,https://base-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=0x...            # funded Base Sepolia key (never commit)
CLIENT_A_PRIVATE_KEY=0x...            # test client wallets used by scripts/send-deposit
CLIENT_B_PRIVATE_KEY=0x...
CLIENT_WALLETS=0x...,0x...

# ---- infra ----
DATABASE_URL=postgres://postgres@localhost:5432/mopay
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070

# ---- service secrets (generate your own) ----
MOBEE_API_KEY=mopay-dev
MOBEE_API_SECRET=change-me
BIFAST_WEBHOOK_SECRET=change-me
ADMIN_TOKEN=change-me
