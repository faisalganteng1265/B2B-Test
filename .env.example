# ---- chain ----
CHAIN=base-sepolia
# comma separated; first is primary, rest are viem fallback transports
RPC_URLS=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=0x...            # funded Base Sepolia key (never commit)
CLIENT_A_PRIVATE_KEY=0x...            # test client wallets used by scripts/send-deposit
CLIENT_B_PRIVATE_KEY=0x...
CLIENT_WALLETS=0x...,0x...

# ---- infra ----
DATABASE_URL=postgres://postgres@localhost:5432/mopay
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070

# ---- service secrets (generate your own) ----
# exchange (PAKD): INDODAX Trade API 2.0 — mock locally (apps/indodax-mock)
INDODAX_URL=http://localhost:4100
INDODAX_API_KEY=change-me
INDODAX_API_SECRET=change-me-at-least-16-chars
# Mopay's own bank account (same name as the exchange KYC); IDR is swept here
MOPAY_BANK_CODE=014
MOPAY_BANK_ACCOUNT=5270011223
MOPAY_BANK_NAME=PT MOPAY TEKNOLOGI INDONESIA
BIFAST_WEBHOOK_SECRET=change-me
ADMIN_TOKEN=change-me
BIFAST_API_KEY=pjp-dev-key

# ---- mock behaviour ----
PRICE_SOURCE=indodax          # indodax (real public price) | fixed (offline tests)
# chaos defaults for the demo (both mocks read these; change live via dashboard)
FAIL_RATE=0.3
FAIL_AFTER_RATE=0
TIMEOUT_RATE=0
LATENCY_MS_MIN=0
LATENCY_MS_MAX=300
DUPLICATE_CALLBACK_RATE=0.1
LATE_CALLBACK_MS=0
DROP_CALLBACK_RATE=0
FINAL_FAILURE_RATE=0
